# RIERBUX.COM Credentials & Config
RIERBUX_BASE_URL=https://rierbux.com
RIERBUX_EMAIL=your_email@example.com
RIERBUX_PASSWORD=your_password_here

# Opsional: Official RierBux API Key (https://rierbux.com/settings/api)
# Bisa juga dibuat otomatis dari Dashboard atau: node rierbux.js apikey create "RierBux CLI"
RIERBUX_API_KEY=

# Opsional: Inject cookie session manual jika login via Google OAuth
# RIERBUX_SESSION_COOKIES=__Secure-rierbux.session_token=...

# Google Sheets Webhook Bridge v3 (samakan URL + SECRET dengan google-apps-script.gs & GerbangAPI)
GSHEET_WEBHOOK_URL=
GSHEET_SECRET=

# Opsional: Outbound Webhook Callback URL (POST JSON otomatis setiap order selesai)
WEBHOOK_CALLBACK_URL=

# Web Dashboard / Worker / Dokploy Settings
HEALTH_PORT=3030
POLL_INTERVAL_MS=5000
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_SECRET=        (kosongkan untuk lokal tanpa password; isi jika deploy ke VPS/Dokploy)
# RIERBUX_DATA_DIR=.
